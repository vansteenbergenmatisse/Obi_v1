# Eval reports are generated, but the committed floor is tracked so the
# documented eval baseline can't silently drift (git can't re-include a file
# whose parent dir is excluded, so exclude the contents and re-include the floor).
eval-reports/*
!eval-reports/baseline.json
!eval-reports/baseline.md

# PLAN 11.1c: generated by `pnpm --filter web build:obi` (hooked into next build), not committed
apps/web/public/obi.js

# Substep 0.5.1: Playwright browser-test artifacts (traces, screenshots, HTML reports)
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/

# Obi agent harness scratch: the /obi-change active-substep marker and the
# settings.json fallback profile file. Session-local, never committed.
.obi/
