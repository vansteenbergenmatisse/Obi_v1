# Python
__pycache__/
*.py[cod]
.venv/
.uv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/

# Node
node_modules/
.next/
.turbo/
dist/
*.tsbuildinfo

# Env / secrets
.env
.env.local
*.local

# Local, uncommitted Claude working rules
CLAUDE.local.md

# OS
.DS_Store

# Data / local
*.log
/tmp/
coverage/

# Eval reports are generated, but the committed floor is tracked so the
# documented eval baseline can't silently drift (git can't re-include a file
# whose parent dir is excluded, so exclude the contents and re-include the floor).
eval-reports/*
!eval-reports/baseline.json
!eval-reports/baseline.md
