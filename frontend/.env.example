# frontend reads its own env files (Next.js does not walk up to the repo-root .env), so the
# chat proxy's config lives here, not in the root .env.example. Copy this to frontend/.env.local.

# ---- Automation API proxy (PLAN 4.5) ----
# Server-only — read exclusively in features/chat/server route handlers, never sent to the
# browser (no NEXT_PUBLIC_ prefix). Must be the exact same value as backend's
# CHAT_API_KEY (root .env) — that's the shared secret the proxy authenticates with.
CHAT_API_KEY=changeme
# Base URL of the running backend FastAPI service.
AUTOMATION_API_BASE_URL=http://localhost:8000

# ---- PLAN 11.1c: Obi embed (ADR-0014) ----
# The pilot invite token (WIDGET_ACCESS_TOKEN, idea #6) was retired here — the browser->proxy leg
# is no longer invite-gated. Scope now comes from a platform-signed user JWT the Obi `/embed`
# frame forwards on `Authorization: Bearer <jwt>`; the proxy threads it to the backend as
# `X-Obi-Token`, which is the actual scope authority (verified there). No token -> general-only,
# never an error. See docs/embedding/PHASE-11.1c-obi-embed-jwt-spec.md.
#
# Override to point BOTH apps at one local/staging platforms file, e.g. knowledge-base/config/platforms.local.json
# (see docs/embedding/obi-embed-local-test-keys.md). Same variable name as the backend's
# `PLATFORMS_PATH` setting, read by features/embed/platforms.ts for the /embed CSP.
PLATFORMS_PATH=
# Where obi.js points its iframe/postMessage targetOrigin — the Obi app's own deployed origin.
# Empty/unset falls back to the current page's own origin (fine for local dev, where obi.js and
# /embed are served by the same app). Injected at BUILD time (esbuild --define, `build:obi`
# script), not read at runtime — set it before running `pnpm --filter web build:obi`.
OBI_ORIGIN=
#
# Local test-host RS256 key pairs (test-mews/test-toast/test-opera/test-none) — see
# docs/embedding/obi-embed-local-test-keys.md for how to generate these with openssl. Throwaway,
# local-only, never committed.
# TEST_OBI_PRIVATE_KEY_MEWS=
# TEST_OBI_PUBLIC_KEY_MEWS=
# TEST_OBI_PRIVATE_KEY_TOAST=
# TEST_OBI_PUBLIC_KEY_TOAST=
# TEST_OBI_PRIVATE_KEY_OPERA=
# TEST_OBI_PUBLIC_KEY_OPERA=
# TEST_OBI_PRIVATE_KEY_NONE=
# TEST_OBI_PUBLIC_KEY_NONE=

# ---- Dev/verification: knowledge-scope switcher (PLAN 10.8) ----
# Browser-exposed (NEXT_PUBLIC_ prefix) on purpose — it only toggles a dev/verification control.
# Set to "true" to show a knowledge-scope switcher in the widget header so you can prove the four
# scopes (obi-general-test/obi-mews-test/obi-operacloud-test/obi-toast-test, ADR-0011) return
# different, isolated evidence live in the UI. Leave unset/empty for real embeds: a deployment
# declares its scope once via the widget's
# `knowledgeScope` prop, not through a user-visible switch.
NEXT_PUBLIC_SHOW_SCOPE_SWITCHER=
