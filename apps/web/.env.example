# apps/web reads its own env files (Next.js does not walk up to the repo-root .env), so the
# chat proxy's config lives here, not in the root .env.example. Copy this to apps/web/.env.local.

# ---- Automation API proxy (PLAN 4.5) ----
# Server-only — read exclusively in features/chat/server route handlers, never sent to the
# browser (no NEXT_PUBLIC_ prefix). Must be the exact same value as apps/automation's
# CHAT_API_KEY (root .env) — that's the shared secret the proxy authenticates with.
CHAT_API_KEY=changeme
# Base URL of the running apps/automation FastAPI service.
AUTOMATION_API_BASE_URL=http://localhost:8000

# ---- Widget browser access (docs/future-ideas/IDEAS.md idea #6, closed 2026-08-21) ----
# A different secret from CHAT_API_KEY above: that one covers proxy->backend, this one covers
# browser->proxy, which previously had no auth at all. Server-only (no NEXT_PUBLIC_ prefix) —
# read fresh in features/chat/server/auth.ts, fails closed (503) if unset, same posture as
# CHAT_API_KEY. Share it with trusted pilot users as `?access_token=<value>` on the site URL;
# the widget captures it into sessionStorage on first load and strips it from the visible URL.
# Generate a long random value (e.g. `openssl rand -hex 32`) — it's distributed via URL, so
# treat it as public-ish once shared and rotate it if the invite link leaks.
WIDGET_ACCESS_TOKEN=changeme
