# ---- Confluence Cloud (source of truth) ----
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=changeme
# Which spaces / page-subtrees to sync now live in the `source_scope` DB table (PLAN 3.5.6),
# not an env var — CONFLUENCE_SPACES was dead code (zero consumers) and has been removed.
# Seed rows with: uv run python scripts/seed_source_scope.py --root-type space --root-id <id>
# Shared secret used to authenticate inbound Confluence webhooks (HMAC)
CONFLUENCE_WEBHOOK_SECRET=changeme
# Account ID of our integration's service account (self-event detection)
CONFLUENCE_SERVICE_ACCOUNT_ID=
# Consecutive-failure circuit breaker for the Confluence REST client (PLAN 4.6.7)
CONFLUENCE_BREAKER_THRESHOLD=5
# Attachment download caps (fixes/phase-2 wiring) — bound memory/CPU, not a scale claim.
CONFLUENCE_ATTACHMENT_MAX_BYTES=20971520
CONFLUENCE_ATTACHMENT_MAX_PER_PAGE=200

# ---- Models ----
ANTHROPIC_API_KEY=changeme
ROUTING_MODEL=claude-haiku-4-5-20251001
ANSWER_MODEL=claude-sonnet-5

# ---- Embeddings (Phase 3) ----
# provider: openai | voyage | local. Offline dev without a key falls back to a deterministic
# Fake provider. EMBEDDING_DIM sets the pgvector column width; >2000 dims index via halfvec
# (pgvector >= 0.7.0 required — see ADR-0002).
# This project uses OpenAI text-embedding-3-large @ 3072 dims; the halfvec index is built for it.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
OPENAI_API_KEY=changeme
# Alternative provider (unused here): voyage-3-large @ 1024 dims — set the three vars above to match.
VOYAGE_API_KEY=
# Embedding-call controls (LLM-CALL: C4 timeout/retry/breaker, C10 abuse cap)
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_BATCH=128
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BREAKER_THRESHOLD=5
EMBEDDING_MAX_TEXTS_PER_CALL=20000

# ---- Contextual retrieval (Phase 3, LLM-CALL) ----
# When enabled + ANTHROPIC_API_KEY set, a cheap model writes a per-chunk context prefix
# (document context prompt-cached). Disabled or keyless -> deterministic metadata-only prefix.
CONTEXTUALIZATION_ENABLED=true
CONTEXTUALIZATION_TIMEOUT_SECONDS=30
CONTEXTUALIZATION_MAX_RETRIES=2
CONTEXTUALIZATION_MAX_DOC_CHARS=60000

# ---- Reranker (cross-encoder, PLAN 3.5.2) ----
# provider empty -> FakeReranker offline; else cohere | local
RERANKER_PROVIDER=
RERANKER_API_KEY=
RERANKER_LOCAL_MODEL=BAAI/bge-reranker-base
# Refusal floor (PLAN 4, tuned in 3.5.5): top cross-encoder score below this -> refuse + route
# to a human. Cohere rerank-v3.5 scores are in [0, 1]. Provisional from the fixture run.
REFUSAL_MIN_RERANK_SCORE=0.10

# ---- Database (PostgreSQL + pgvector) ----
# Local dev: the docker-compose pg on :5434.
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5434/omniboost_rag
#
# Retrieval reads run as a non-owner rag_reader role so source-level RLS is enforced (ADR-0004).
# The role is created by knowledge-base/local/init/01-roles.sql on a fresh volume (password 'rag_reader'
# locally — change it in real deployments). Leave empty to fall back to DATABASE_URL, which runs as
# the owner/superuser and BYPASSES RLS (fine for single-source local dev; NOT for production).
# DATABASE_READER_URL=postgresql+psycopg://rag_reader:rag_reader@localhost:5434/omniboost_rag
#
# Supabase (managed Postgres + pgvector) — same engine, so just repoint DATABASE_URL.
# Use the SESSION POOLER or DIRECT connection (port 5432), NOT the :6543 transaction pooler,
# so Alembic migrations and prepared statements work. Keep the postgresql+psycopg:// prefix.
# Enable pgvector once via the SQL editor: `create extension if not exists vector;`
# (needs pgvector >= 0.7.0 for the halfvec 3072-dim index — see ADR-0002).
# No SUPABASE_URL / ANON_KEY / SERVICE_ROLE_KEY needed: the app talks to Postgres directly,
# not through PostgREST or the JS SDK.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Answer runtime (PLAN 4.4, LLM-CALL: C4 timeout/retry/breaker, C10 abuse cap) ----
# Backs both the rewrite (ROUTING_MODEL) and generation (ANSWER_MODEL) calls.
ANSWER_TIMEOUT_SECONDS=30
ANSWER_MAX_RETRIES=2
ANSWER_BREAKER_THRESHOLD=5
ANSWER_MAX_INPUT_CHARS=20000

# ---- Chat endpoint: POST /chat + PATCH /chat/{trace_id}/feedback (PLAN 4.4) ----
# Shared secret between the trusted web proxy (frontend) and this API. Required — the endpoint
# fails closed (503) when unset, same posture as CONFLUENCE_WEBHOOK_SECRET.
# Next.js does not read this repo-root file, so frontend needs the identical value in its own
# frontend/.env.local (see frontend/.env.example) — the two processes must agree.
CHAT_API_KEY=changeme
# Set only during a rotation's overlap window (PLAN 5): the outgoing key, still accepted
# alongside CHAT_API_KEY above so in-flight callers don't 401. Empty otherwise. See
# docs/runbooks/chat-api-key-rotation.md and scripts/rotate_chat_api_key.py.
CHAT_API_KEY_PREVIOUS=
CHAT_RATE_LIMIT_PER_MINUTE=20
# Keyed by client IP only, never the caller-reported principal (PLAN 4.6.4 — a principal-first key
# let a caller bypass the limit by rotating principal). Bounds the limiter's in-process memory
# across distinct IPs (oldest-tracked evicted first once exceeded), same shape as the caches below.
CHAT_RATE_LIMITER_MAX_TRACKED_KEYS=1000
CHAT_MAX_HISTORY_TURNS=20
CHAT_MAX_MESSAGE_CHARS=4000
# PLAN 7.3/7.4, ADR-0009 decision 7: caps on ChatMessage.images. Per-turn count mirrors
# frontend's already-shipped composer.tsx MAX_ATTACHMENTS=4. Per-image byte cap is a provisional
# ceiling under Anthropic's own ~5MB per-image API limit; ADR-0009 leaves the real, usage-tuned
# value undecided — re-tune once real image traffic exists.
CHAT_MAX_IMAGES_PER_TURN=4
CHAT_MAX_IMAGE_BYTES=5000000
CHAT_OUTPUT_MAX_ANSWER_CHARS=8000
CHAT_TOKEN_CHUNK_CHARS=40
CHAT_STREAM_INTERVAL_MS=15
CHAT_IDEMPOTENCY_TTL_SECONDS=300
CHAT_IDEMPOTENCY_CACHE_MAX_ENTRIES=500

# PLAN 5: exact-match answer cache in front of AnswerService — same TTL shape as the
# idempotency cache above. See app/features/rag_agent/application/answer_cache.py.
CHAT_ANSWER_CACHE_TTL_SECONDS=300
CHAT_ANSWER_CACHE_MAX_ENTRIES=500

# ---- Retrieval / budgets ----
EVIDENCE_TOKEN_BUDGET=7000
PROVIDER_TIMEOUT_SECONDS=8

# ---- Reconciliation schedules ----
# lightweight: daily; complete: every 14 days
LIGHTWEIGHT_RECON_CRON=0 3 * * *
COMPLETE_RECON_INTERVAL_DAYS=14

# ---- Knowledge scopes: multi-provider tagging (PLAN 10, ADR-0011) ----
# The RECOGNIZED SCOPE NAMES themselves (general/mews/opera-cloud/toast/...) are NOT here —
# they live in backend/config/knowledge_scopes.json, a dedicated global file an
# operator edits directly. To add a new integration platform: add it there, then label the
# matching Confluence pages with that exact tag — no code change needed anywhere.
# The two vars below are runtime toggles only, not the scope list.
# Deployment-level fallback scope when a chat request omits knowledge_scope. Empty -> general-only.
DEFAULT_KNOWLEDGE_SCOPE=
# Rollout flag: off (default) -> zero behavior change, the tags filter is never applied
# regardless of what a caller passes. Flip only after the corpus migration (PLAN 10.7) confirms
# every live page carries a recognized scope label — the gate is:
#   uv run python scripts/verify_knowledge_scope_backfill.py   (exit 0 = ready to flip)
ENABLE_KNOWLEDGE_SCOPE_FILTERING=false
# Cap on always-present curated knowledge entries composed into evidence per answer (PLAN 10.6).
CURATED_KNOWLEDGE_MAX_ENTRIES=5

# ---- Runtime ----
LOG_LEVEL=INFO
ENV=local
