# ---- Confluence Cloud (source of truth) ----
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=changeme
# Which spaces / page-subtrees to sync now live in the `source_scope` DB table (PLAN 3.5.6),
# not an env var — CONFLUENCE_SPACES was dead code (zero consumers) and has been removed.
# Seed rows with: uv run python scripts/seed_source_scope.py --root-type space --root-id <id>
# Shared secret used to authenticate inbound Confluence webhooks (HMAC)
CONFLUENCE_WEBHOOK_SECRET=changeme
# Account ID of our integration's service account (self-event detection)
CONFLUENCE_SERVICE_ACCOUNT_ID=

# ---- Models ----
ANTHROPIC_API_KEY=changeme
ROUTING_MODEL=claude-haiku-4-5-20251001
ANSWER_MODEL=claude-sonnet-5

# ---- Embeddings (Phase 3) ----
# provider: openai | voyage | local. Offline dev without a key falls back to a deterministic
# Fake provider. EMBEDDING_DIM sets the pgvector column width; >2000 dims index via halfvec
# (pgvector >= 0.7.0 required — see ADR-0002).
# This project uses OpenAI text-embedding-3-large @ 3072 dims; the halfvec index is built for it.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
OPENAI_API_KEY=changeme
# Alternative provider (unused here): voyage-3-large @ 1024 dims — set the three vars above to match.
VOYAGE_API_KEY=
# Embedding-call controls (LLM-CALL: C4 timeout/retry/breaker, C10 abuse cap)
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_BATCH=128
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BREAKER_THRESHOLD=5
EMBEDDING_MAX_TEXTS_PER_CALL=20000

# ---- Contextual retrieval (Phase 3, LLM-CALL) ----
# When enabled + ANTHROPIC_API_KEY set, a cheap model writes a per-chunk context prefix
# (document context prompt-cached). Disabled or keyless -> deterministic metadata-only prefix.
CONTEXTUALIZATION_ENABLED=true
CONTEXTUALIZATION_TIMEOUT_SECONDS=30
CONTEXTUALIZATION_MAX_RETRIES=2
CONTEXTUALIZATION_MAX_DOC_CHARS=60000

# ---- Reranker (cross-encoder, PLAN 3.5.2) ----
# provider empty -> FakeReranker offline; else cohere | local
RERANKER_PROVIDER=
RERANKER_API_KEY=
RERANKER_LOCAL_MODEL=BAAI/bge-reranker-base
# Refusal floor (PLAN 4, tuned in 3.5.5): top cross-encoder score below this -> refuse + route
# to a human. Cohere rerank-v3.5 scores are in [0, 1]. Provisional from the fixture run.
REFUSAL_MIN_RERANK_SCORE=0.10

# ---- Database (PostgreSQL + pgvector) ----
# Local dev: the docker-compose pg on :5434.
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5434/omniboost_rag
#
# Retrieval reads run as a non-owner rag_reader role so source-level RLS is enforced (ADR-0004).
# The role is created by infra/foundation/init/01-roles.sql on a fresh volume (password 'rag_reader'
# locally — change it in real deployments). Leave empty to fall back to DATABASE_URL, which runs as
# the owner/superuser and BYPASSES RLS (fine for single-source local dev; NOT for production).
# DATABASE_READER_URL=postgresql+psycopg://rag_reader:rag_reader@localhost:5434/omniboost_rag
#
# Supabase (managed Postgres + pgvector) — same engine, so just repoint DATABASE_URL.
# Use the SESSION POOLER or DIRECT connection (port 5432), NOT the :6543 transaction pooler,
# so Alembic migrations and prepared statements work. Keep the postgresql+psycopg:// prefix.
# Enable pgvector once via the SQL editor: `create extension if not exists vector;`
# (needs pgvector >= 0.7.0 for the halfvec 3072-dim index — see ADR-0002).
# No SUPABASE_URL / ANON_KEY / SERVICE_ROLE_KEY needed: the app talks to Postgres directly,
# not through PostgREST or the JS SDK.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Retrieval / budgets ----
EVIDENCE_TOKEN_BUDGET=7000
PROVIDER_TIMEOUT_SECONDS=8

# ---- Reconciliation schedules ----
# lightweight: daily; complete: every 14 days
LIGHTWEIGHT_RECON_CRON=0 3 * * *
COMPLETE_RECON_INTERVAL_DAYS=14

# ---- Runtime ----
LOG_LEVEL=INFO
ENV=local
